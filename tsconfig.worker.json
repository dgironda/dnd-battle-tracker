{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "types": ["./worker-configuration.d.ts", "vite/client"],
  },
  // `functions` is the Pages Functions directory — the PostHog relay lives
  // there and is real production code, so it gets typechecked like the rest.
  "include": ["./worker-configuration.d.ts", "./worker", "./functions", "./server"]
}
