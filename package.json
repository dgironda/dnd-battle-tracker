{
	"name": "dnd-battle-tracker",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:share": "node tools/dev-share.mjs",
		"dev:player": "vite --port 5174 --strictPort",
		"dev:rooms": "wrangler dev -c workers/battle-rooms/wrangler.jsonc",
		"dev:api": "wrangler pages dev",
		"dev:pages": "npm run build && wrangler pages dev",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"test": "vitest run",
		"deploy": "npm run build && wrangler pages deploy",
		"deploy:rooms": "wrangler deploy -c workers/battle-rooms/wrangler.jsonc",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"driver.js": "^1.4.0",
		"posthog-js": "^1.429.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-helmet-async": "^2.0.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.2.1",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^5.0.0",
		"eslint": "^9.33.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"jsdom": "^29.1.1",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.39.1",
		"vite": "^7.1.2",
		"vitest": "^4.0.18",
		"wrangler": "^4.38.0"
	}
}
